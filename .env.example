# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# OpenRouter Configuration (if used)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# E2E Testing Configuration
E2E_USERNAME_ID=your_e2e_username_id_here
E2E_USERNAME=your_e2e_username_here
E2E_PASSWORD=your_e2e_password_here

# Required for E2E database cleanup (teardown)
# Use the same values as SUPABASE_URL and SUPABASE_KEY above
# These need to be available in the test environment (.env.test)
