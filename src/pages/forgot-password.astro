---
import AuthLayout from "@/layouts/AuthLayout.astro";
import ForgotPasswordForm from "@/components/auth/ForgotPasswordForm";

export const prerender = false;

// Guard handled by middleware
---

<AuthLayout title="Forgot Password - 10x Cards">
  <div class="text-center mb-8">
    <h1 class="text-3xl font-bold mb-2 text-neutral-900 dark:text-neutral-100">Forgot password?</h1>
    <p class="text-neutral-600 dark:text-neutral-400">
      Enter your email and we'll send you a link to reset your password
    </p>
  </div>

  <ForgotPasswordForm client:load />

  <div class="mt-6 text-center text-sm">
    <span class="text-neutral-600 dark:text-neutral-400">Remember your password?</span>
    {" "}
    <a
      href="/login"
      class="font-medium text-neutral-900 hover:text-neutral-700 dark:text-neutral-100 dark:hover:text-neutral-300 transition-colors"
    >
      Sign in
    </a>
  </div>
</AuthLayout>
