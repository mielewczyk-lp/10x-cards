---
import Layout from "@/layouts/Layout.astro";
import FlashcardListPanel from "@/components/flashcards/FlashcardListPanel";

export const prerender = false;

// Protected page - user must be logged in (enforced by middleware)
const { user } = Astro.locals;
---

<Layout title="My Flashcards">
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">My Flashcards</h1>
      <p class="text-neutral-600 dark:text-neutral-400 mt-2">Manage and review your accepted flashcards</p>
    </div>

    <FlashcardListPanel client:load />
  </main>
</Layout>
