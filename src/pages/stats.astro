---
import Layout from "@/layouts/Layout.astro";
import StatsPanel from "@/components/stats/StatsPanel";
---

<Layout title="Statistics - 10x Cards">
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <div class="mb-8">
        <h1 class="text-3xl font-bold mb-2 text-neutral-900 dark:text-neutral-100">Statistics</h1>
        <p class="text-neutral-600 dark:text-neutral-400">Track your AI usage and acceptance metrics</p>
      </div>

      <StatsPanel client:load />
    </div>
  </main>
</Layout>
