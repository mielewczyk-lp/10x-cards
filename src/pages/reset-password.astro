---
import AuthLayout from "@/layouts/AuthLayout.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";

const url = new URL(Astro.request.url);
const accessToken = url.searchParams.get("access_token") || "";
---

<AuthLayout title="Reset Password - 10x Cards">
  <div class="text-center mb-8">
    <h1 class="text-3xl font-bold mb-2 text-neutral-900 dark:text-neutral-100">Reset your password</h1>
    <p class="text-neutral-600 dark:text-neutral-400">Enter your new password below</p>
  </div>

  <ResetPasswordForm client:load accessToken={accessToken} />

  <div class="mt-6 text-center text-sm">
    <span class="text-neutral-600 dark:text-neutral-400">Remember your password?</span>
    {" "}
    <a
      href="/login"
      class="font-medium text-neutral-900 hover:text-neutral-700 dark:text-neutral-100 dark:hover:text-neutral-300 transition-colors"
    >
      Sign in
    </a>
  </div>
</AuthLayout>
